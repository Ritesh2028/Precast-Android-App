{
  "expo": {
    "name": "PrecastEzy",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/precastezy-icon.png",
    "scheme": "precastezy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riteshrai628.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Scan QR codes and capture element photos."
      }
    },
    "android": {
      "package": "com.riteshrai628.mobile",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "icon": "./assets/precastezy-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/precastezy-icon.png",
        "backgroundColor": "#F1F5FE"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "owner": "ritesh_628",
    "extra": {
      "eas": {
        "projectId": "df3780fe-f464-424c-876f-a1942635780a"
      }
    }
  }
}
