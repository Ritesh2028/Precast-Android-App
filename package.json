{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "start:phone": "bash scripts/start-phone.sh",
    "start:tunnel": "expo start --go --tunnel ngrok",
    "start:android": "expo start --clear",
    "start:emulator": "adb reverse tcp:8081 tcp:8081 2>/dev/null; REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start --clear --localhost",
    "logs:android": "adb logcat *:S ReactNativeJS:V ReactNative:V ExpoModules:V",
    "android": "expo run:android",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:apk:debug": "cd android && ./gradlew assembleDebug",
    "postinstall": "patch-package && bash scripts/clean-ide-java-metadata.sh",
    "clean:ide-java": "bash scripts/clean-ide-java-metadata.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "axios": "^1.12.2",
    "expo": "^58.0.26",
    "expo-camera": "~58.0.14",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-view-shot": "6.1.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.4",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "patch-package": "^8.0.1"
  },
  "private": true
}
